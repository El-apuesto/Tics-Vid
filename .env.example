# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Dev: http://localhost:5173
# Render prod: https://your-service-name.onrender.com
FRONTEND_URL=http://localhost:5173

# ── Merchize (REQUIRED for order fulfillment) ─────────────────────────────────
# Get both values from: Merchize Dashboard → Integrations → API

# Your store-specific API base URL — looks like:
# https://bo-group-X-Y.merchize.com/{store_id}/bo-api
MERCHIZE_API_BASE_URL=

# Your monthly rotating access token (JWT)
MERCHIZE_ACCESS_TOKEN=

# Secret key shown in Merchize Dashboard → Webhooks
# Used to verify incoming webhook requests from Merchize
MERCHIZE_WEBHOOK_SECRET=

# ── Stripe (OPTIONAL — add to enable card payment before Merchize fulfillment) ─
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get webhook secret from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
